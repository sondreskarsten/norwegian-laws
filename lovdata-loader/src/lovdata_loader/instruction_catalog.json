        "\\bblir\\s+(?:første|annet|andre|tredje|fjerde|femte|sjette|sjuende|syvende|åttende|niende|tiende|ellevte|tolvte|trettende|fjortende|femtende|sekstende|syttende|attende|nittende|tjuende|siste)\\b",
        "\\bvert\\s+(?:første|andre|tredje|fjerde|femte|sjette|sjuande|åttande|niande|tiande|ellevte|tolvte|siste)\\b",
        "\\bomnummereres\\b",
        "\\bomnummererast\\b",
        "\\bendrer\\s+nummer\\b",
        "\\bendrar\\s+nummer\\b",
        "\\bgis\\s+kapitteloverskriften",
        "\\bplasseres\\s+i\\b",
        "\\bplasserast\\s+i\\b",
        "\\bskal\\s+hete\\b",
        "\\bskal\\s+heite\\b",
        "\\bskal\\s+ha\\s+(?:ny\\s+)?overskrift",
        "\\bbetegnelsen\\b.*\\bendres\\b",
        "\\bforskyves\\b",
        "\\bblir\\s+etter\\s+endringen\\b",
        "\\bfår\\s+(?:følgende\\s+)?(?:overskrift|tittel)\\b",
        "\\bskal\\s+komme\\s+etter\\b",
        "\\brettes\\s+i\\s+henhold\\s+til\\s+ny\\s+nummerering\\b",
        "\\bdeles\\s+inn\\s+i\\s+kapittel\\b",
        "\\bfår\\s+overskriften\\b",
        "\\bgis\\s+(?:ny\\s+)?overskrift",
        "\\bforskyvning\\b",
        "\\bforskyving\\b"
      ],
      "examples": [
        "Nåværende § 4 blir ny § 5.",
        "Nåværende tredje og fjerde ledd blir fjerde og nytt femte ledd.",
        "Nåværende bokstaver o) til w) blir p) til x).",
        "Nåværende § 8 plasseres i kapittel 3."
      ]
    },
    {
      "id": "move",
      "effect": "A provision or part is moved to another place in the document.",
      "patterns": [
        "\\bflyttes\\b",
        "\\bflyttast\\b",
        "\\bflytter\\b",
        "\\bflyttes\\s+til\\b",
        "\\bflyttet\\b",
        "\\bflytta\\b"
      ],
      "examples": [
        "§ 5 flyttes til kapittel 2 og blir ny § 2-4."
      ]
    },
    {
