{
  "version": 1,
  "description": "Catalogue of every operation wording found in Lovtidend amendment instructions (2001 onwards). An instruction that looks like an amendment instruction but matches no operation here is reported as an unknown form and must be added by a pull request before the parser can attribute it.",
  "target_units": [
    "§",
    "§§",
    "ledd",
    "punktum",
    "setning",
    "nr.",
    "nummer",
    "punkt",
    "bokstav",
    "strekpunkt",
    "kolon",
    "kapittel",
    "kap.",
    "del",
    "avsnitt",
    "avdeling",
    "vedlegg",
    "tillegg",
    "overskrift",
    "overskriften",
    "tittel",
    "tittelen",
    "innledningen",
    "innleiinga",
    "fotnote",
    "note",
    "tabell",
    "figur",
    "kolonne",
    "rad"
  ],
  "operations": [
    {
      "id": "replace_text",
      "effect": "The named provision, heading or document part gets the quoted wording (new or replaced text).",
      "patterns": [
        "\\bskal\\s+lyde",
        "\\bskal\\s+lyda\\b",
        "\\bskal\\s+(?:§|§§|ny|nye|nytt|kapittel|overskrift|tittel|vedlegg|del|innledningen)[^.:]*?\\blyde\\b",
        "\\blyde\\s*:",
        "\\bskal\\s+ha\\s+følgende\\s+ordlyd\\b",
        "\\bfår\\s+følgende\\s+ordlyd\\b",
        "\\bfår\\s+følgjande\\s+ordlyd\\b",
        "\\bskal\\s+ha\\s+(?:denne|følgende|følgjande)\\s+ordlyde?n?\\b",
        "\\bendres\\s+til\\s+å\\s+lyde\\b",
        "\\blyde\\s+(?:slik|som\\s+følger|såleis)\\b",
        "\\btil\\s+å\\s+lyde\\b",
        "\\blyder\\s+i\\s+sin\\s+helhet\\b",
        "\\bmed\\s+følgende\\s*:$",
        "\\berstattes\\s+(?:\\S+\\s+){0,3}med\\s+følgende\\b",
        "\\bskal\\s+ha\\s+(?:slik|denne)\\s+ordlyd",
        "\\berstatter\\s+all\\s+gammel\\s+tekst\\b",
        "\\berstattes\\s+i\\s+sin\\s+helhet\\s+av\\b",
        "\\berstattast\\s+i\\s+sin\\s+heilskap\\b"
      ],
      "examples": [
        "§ 3 skal lyde:",
        "§ 1-2 første ledd nr. 4 annet strekpunkt skal lyde:",
        "I lov 17. juni 2005 nr. 90 skal § 3 lyde:",
        "Nytt kapittel 1 A skal lyde:"
      ]
    },
    {
      "id": "new_provision",
      "effect": "A provision, chapter, paragraph or item is added (usually combined with replace_text carrying its wording).",
      "patterns": [
        "^(?:Ny|Nye|Nytt)\\s+(?:§|§§|kapittel|kap\\.|ledd|punktum|bokstav|nr\\.|nummer|punkt|del|avsnitt|vedlegg|overskrift|strekpunkt)",
        "\\bny\\s+§",
        "\\bnye\\s+§§?",
        "\\bnytt\\s+(?:kapittel|vedlegg|ledd|punktum|nr\\.|punkt|avsnitt|strekpunkt)\\b",
        "\\bny\\s+(?:bokstav|overskrift|del|tittel|avdeling)\\b",
        "\\bskal\\s+(?:ny|nytt|nye)\\s",
        "\\bnytt\\s+annet\\s+ledd\\b",
        "\\b(?:ny|nytt|nye)\\s+(?:\\w+\\s+)?(?:og\\s+\\w+\\s+)?(?:ledd|punktum|setning|strekpunkt|bokstav|nr\\.|nummer|punkt|avsnitt)\\b"
      ],
      "examples": [
        "Ny § 4 a skal lyde:",
        "§ 5 nytt tredje ledd skal lyde:",
        "I kapittel 3 skal ny § 3-7 lyde:"
      ]
    },
    {
      "id": "repeal",
      "effect": "The named provision, part or whole document ceases to apply.",
      "patterns": [
        "oppheves\\b",
        "opphevast\\b",
        "\\bopphevet\\b",
        "\\bopphevd\\b",
        "\\boppheva\\b",
        "\\bvert\\s+oppheva\\b",
        "\\bblir\\s+oppheva\\b",
        "\\butgår\\b",
        "\\bgår\\s+ut\\b",
        "\\bstrykes\\b",
        "\\bstrykast\\b",
        "\\bslettes\\b",
        "\\bslettast\\b",
        "\\bbortfaller\\b",
        "\\bfell\\s+bort\\b",
        "\\bfaller\\s+bort\\b",
        "^Opphevelse\\s+av\\b",
        "^Oppheving\\s+av\\b",
        "\\boppheves\\s+fra\\b",
        "\\btas\\s+(?:\\S+\\s+){0,8}ut\\b",
        "\\btakast\\s+(?:\\S+\\s+){0,8}ut\\b",
        "\\bopphever\\b",
        "\\bopphevar\\b",
        "\\bfjernes\\b",
        "\\bfjernast\\b",
        "\\butgå\\b",
        "\\bmå\\s+(?:denne\\s+)?(?:kunngjøringen\\s+)?utgå\\b"
      ],
      "examples": [
        "§ 12 oppheves.",
        "§ 7 tredje ledd oppheves.",
        "Følgende lov oppheves:",
        "Følgjande lov vert opphevd:"
      ]
    },
    {
      "id": "renumber",
      "effect": "Existing provisions, paragraphs, sentences or items get new numbers, letters or positions.",
      "patterns": [
